type Result = 
 variant {
   err: text;
   ok: text;
 };
type RecipeSummary = 
 record {
   description: text;
   hasPhoto: bool;
   id: text;
   servings: nat;
   tags: vec text;
   title: text;
 };
type Recipe = 
 record {
   author: opt principal;
   cookMinutes: opt nat;
   difficulty: opt Difficulty;
   id: text;
   markdown: text;
   prepMinutes: opt nat;
   servings: nat;
   tags: vec text;
   title: text;
 };
type Photo = 
 record {
   contentType: text;
   data: blob;
 };
type NewRecipe = 
 record {
   cookMinutes: opt nat;
   description: text;
   difficulty: opt Difficulty;
   ingredients: vec text;
   name: text;
   photo: opt Photo;
   prepMinutes: opt nat;
   servings: nat;
   steps: vec text;
   tags: opt vec text;
 };
type Difficulty = 
 variant {
   easy;
   hard;
   medium;
 };
service : {
  /// Adds a recipe and returns its id, or a readable error if the input is invalid.
  /// The caller must be signed in (not the anonymous principal) and is stored as
  /// the recipe's `author`.
  addRecipe: (input: NewRecipe) -> (Result);
  getRecipe: (id: text) -> (opt Recipe) query;
  /// The photo of the recipe with this id, or null if it has none or does not exist.
  getRecipePhoto: (id: text) -> (opt Photo) query;
  listRecipes: () -> (vec RecipeSummary) query;
  /// Recipes whose title or ingredient lines contain `searchText` (trimmed,
  /// case-insensitive), in `listRecipes` order. Empty or over-long queries return [].
  searchRecipes: (searchText: text) -> (vec RecipeSummary) query;
}
