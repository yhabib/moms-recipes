type Result = 
 variant {
   err: text;
   ok: text;
 };
type RecipeSummary = 
 record {
   description: text;
   id: text;
   servings: nat;
   tags: vec text;
   title: text;
 };
type Recipe = 
 record {
   cookMinutes: opt nat;
   difficulty: opt Difficulty;
   id: text;
   markdown: text;
   prepMinutes: opt nat;
   servings: nat;
   tags: vec text;
   title: text;
 };
type NewRecipe = 
 record {
   cookMinutes: opt nat;
   description: text;
   difficulty: opt Difficulty;
   ingredients: vec text;
   name: text;
   prepMinutes: opt nat;
   servings: nat;
   steps: vec text;
   tags: opt vec text;
 };
type Difficulty = 
 variant {
   easy;
   hard;
   medium;
 };
service : {
  /// Adds a recipe and returns its id, or a readable error if the input is invalid.
  /// A non-anonymous caller is remembered as the recipe's author.
  addRecipe: (input: NewRecipe) -> (Result);
  /// True if the caller may edit the recipe: the caller is not anonymous and
  /// added this recipe through `addRecipe`. Placeholder and seed recipes,
  /// recipes added before authors were recorded or added anonymously, and
  /// unknown ids return false.
  canEditRecipe: (id: text) -> (bool) query;
  getRecipe: (id: text) -> (opt Recipe) query;
  listRecipes: () -> (vec RecipeSummary) query;
  /// Recipes whose title or ingredient lines contain `searchText` (trimmed,
  /// case-insensitive), in `listRecipes` order. Empty or over-long queries return [].
  searchRecipes: (searchText: text) -> (vec RecipeSummary) query;
}
